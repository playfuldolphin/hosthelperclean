{
  "name": "host-helper-clean",
  "version": "2.0.0",
  "description": "Professional cleaning management platform for Airbnb and rental property hosts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhook",
    "db:setup": "node db/setup.js",
    "db:reset": "psql $DATABASE_URL < db/migrations/001_initial_schema.sql"
  },
  "keywords": [
    "airbnb",
    "cleaning",
    "property-management",
    "stripe",
    "booking-platform"
  ],
  "author": "Host Helper Clean",
  "license": "MIT",
  "dependencies": {
    "stripe": "^14.10.0",
    "express": "^4.18.2",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "nodemailer": "^6.9.7",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "pg": "^8.11.3",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.55.0",
    "@types/node": "^20.10.5"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/host-helper-clean"
  }
}
