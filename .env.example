# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Site Configuration
SITE_URL=http://localhost:3000
# Production: SITE_URL=https://yourdomain.com

# Email Configuration (for transactional emails)
# Use SendGrid, Mailgun, or your SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
FROM_EMAIL=noreply@hosthelperclean.com
SUPPORT_EMAIL=support@hosthelperclean.com

# SMS Configuration (optional - for notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Database Configuration (REQUIRED)
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/hosthelper
# Railway: DATABASE_URL provided automatically
# Heroku: DATABASE_URL provided automatically
# Local development: postgresql://postgres:password@localhost:5432/hosthelper

# JWT Configuration (for user authentication)
JWT_SECRET=your_very_long_random_secret_key_here
JWT_EXPIRES_IN=7d

# AWS S3 Configuration (for photo storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=hosthelper-photos
AWS_REGION=us-east-1

# Google Calendar API (for integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Airbnb API (for integration - if available)
AIRBNB_API_KEY=your_airbnb_api_key
AIRBNB_CLIENT_ID=your_airbnb_client_id

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Environment
NODE_ENV=development
# Production: NODE_ENV=production

# Server Configuration
PORT=3000

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_SUBSCRIPTIONS=false
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_CALENDAR_SYNC=true

# Pricing Configuration
DEFAULT_PLATFORM_FEE_PERCENTAGE=15
HIGH_VOLUME_FEE_PERCENTAGE=10
HIGH_VOLUME_THRESHOLD=20
